# Xpenses server configuration (all optional; defaults shown)

# Address the HTTP server listens on. Keep 127.0.0.1 for local-only use.
# Binding to 0.0.0.0 exposes your financial data to every device on the network
# (there is no authentication layer) — only do that behind a reverse proxy you trust.
XPENSES_ADDR=127.0.0.1:8080

# Directory holding the SQLite database and backups.
XPENSES_DATA_DIR=./data

# Base upload size limit (bytes); a restore file may be up to 10x this. Default 10 MiB.
XPENSES_MAX_UPLOAD_BYTES=10485760

# Log level: debug | info | warn | error
XPENSES_LOG_LEVEL=info

# Serve the built frontend from this directory (empty = API only, use Vite dev server).
XPENSES_STATIC_DIR=./web/dist

# Allowed CORS origin for the Vite dev server. Empty disables CORS.
XPENSES_CORS_ORIGIN=http://localhost:5173

# Default currency code for new accounts.
XPENSES_DEFAULT_CURRENCY=BTN

# Session cookie Secure flag: auto (Secure only over HTTPS), true, false.
XPENSES_SECURE_COOKIES=auto

# Set to true ONLY when running behind a reverse proxy you control; enables
# X-Forwarded-For (login throttling by IP) and X-Forwarded-Proto (Secure cookies).
XPENSES_TRUSTED_PROXY=false
